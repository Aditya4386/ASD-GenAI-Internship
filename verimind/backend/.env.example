# Groq API Configuration
# Get your free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use — available options:
# openai/gpt-oss-120b  (default, most capable)
# openai/gpt-oss-20b
# qwen/qwen3.8-27b
# allam-2-7b
GROQ_MODEL=openai/gpt-oss-120b

# CORS — comma-separated list of allowed frontend origins.
# Use * for development (allows all origins).
# For production set to your actual frontend URL, e.g.:
# ALLOWED_ORIGINS=https://verimind-frontend.onrender.com
ALLOWED_ORIGINS=*

# Optional: HuggingFace token (only needed if switching from TF-IDF to HF embeddings)
# HUGGINGFACEHUB_API_TOKEN=hf_your_token_here