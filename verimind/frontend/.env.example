# Frontend environment variables
# Copy this file to .env.local for local development,
# or set VITE_API_URL as a build-time variable on your hosting platform.

# For local development:
VITE_API_URL=http://localhost:8000

# For Render / production — set this to your backend Web Service URL, e.g.:
# VITE_API_URL=https://verimind-backend.onrender.com
